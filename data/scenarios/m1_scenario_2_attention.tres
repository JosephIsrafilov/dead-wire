wire_reply_by_outcome = {
"amended_other": "SAID WHAT",
"amended_true": "SAID WHAT"
}
amendment_wrong_world_fact = "freight_copy_amended"
amendment_knowledge_fact = "amendment_entered_attention_hold_freight"
