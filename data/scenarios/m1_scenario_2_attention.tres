[gd_resource type="Resource" script_class="TelegraphScenarioData" format=3]

[ext_resource type="Script" path="res://scripts/telegraph/session/telegraph_scenario_data.gd" id="1_scen"]
[ext_resource type="Script" path="res://scripts/telegraph/transmission_data.gd" id="2_trans"]
[ext_resource type="Script" path="res://scripts/telegraph/session/telegraph_commit_option.gd" id="3_commit"]

[sub_resource type="Resource" id="Resource_trans2"]
script = ExtResource("2_trans")
transmission_id = &"trans_m1_02_hold_freight"
true_message = "FREIGHT 71 EAST"
elias_perception = "FREIGHT 71 EAST"
written_transcript = "FREIGHT 71 EAST"

[sub_resource type="Resource" id="Resource_amend2"]
script = ExtResource("3_commit")
action_id = &"amend_copy"
display_label = "AMEND COPY"
requires_correction = true
world_fact = "freight_copy_amended"
knowledge_fact = "amendment_entered_attention_hold_freight"
result_text = "CORRECTION FILED"

[sub_resource type="Resource" id="Resource_file2"]
script = ExtResource("3_commit")
action_id = &"file_as_copied"
display_label = "FILE AS COPIED"
world_fact = "freight_copy_filed"
knowledge_fact = "filed_copy_attention_hold_freight"
result_text = "COPY FILED"

[resource]
script = ExtResource("1_scen")
scenario_id = "attention_hold_freight"
