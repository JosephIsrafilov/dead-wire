misroute_wire_signal = "71 CLEARED"
routing_lapsed_knowledge_fact = "lapsed_attention_hold_freight"
attention_event_id = "door_footsteps"
attention_event_start_time = 4.0
completion_fact = ""
requires_transcript_verification = true
critical_copy = true
transcript_reveal_cues = PackedFloat32Array(0.061404, 0.140351, 0.175439, 0.22807, 0.333333, 0.421053, 0.473684, 0.622807, 0.745614, 0.807018, 0.877193, 0.947368, 1.0)
commit_options = [SubResource("Resource_amend2"), SubResource("Resource_file2")]
commit_deadline_seconds = 30.0
commit_lapsed_world_fact = "freight_copy_unfiled"
commit_lapsed_knowledge_fact = "unfiled_attention_hold_freight"
