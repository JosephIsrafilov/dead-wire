# Out-of-scope tooling output
graphify-out/
.dream-loop/

# Local Python tool environments and bytecode
.venv-tools/
__pycache__/
*.py[cod]

# Local credentials (never publish)
.env
.env.*
!.env.example

# Built beta artifacts (rebuilt via export+package; delivered out-of-band)
builds/

