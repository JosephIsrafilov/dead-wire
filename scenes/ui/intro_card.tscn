[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(680, 0)
layout_mode = 2
theme_override_constants/separation = 18

[node name="PlaceLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.85, 0.68, 1)
