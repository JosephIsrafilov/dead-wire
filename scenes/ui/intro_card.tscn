[node name="OrderLabel" type="RichTextLabel" parent="CenterContainer/VBoxContainer"]
custom_minimum_size = Vector2(660, 165)
layout_mode = 2
theme_override_colors/default_color = Color(0.78, 0.72, 0.60, 1)
theme_override_fonts/normal_font = ExtResource("4_serif")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = false
text = "BLACK CREEK & WESTERN RY. — TELEGRAPH DEPT. — ORDER 41

E. CRANE TO RELIEVE NIGHT OPERATOR AT BLACK CREEK (CALL: BC).
MINE JUNCTION (MJ) HAS BEEN SEALED SINCE THE FLOOD OF OCT. 1885.
CHECK THE TIMETABLE AND DISPATCH LEDGER BEFORE OPENING THE LINE.
KEEP THE WIRE. COPY WHAT COMES."
fit_content = true

[node name="HintLabel" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
