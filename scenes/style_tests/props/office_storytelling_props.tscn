text = "NIGHT ORDERS
11 P.M. — 6 A.M."
font_size = 16
outline_size = 0

; The notices pinned round the register. Without ink they were blank orange
; rectangles, which is what made the board read as unfinished. Each one is the
; kind of paper that accumulates on a depot board: a timetable, a general
; circular, a hand-written memo, and the standing rule.
;
; 2026-10-21: the papers are now twice the area and sit in the four quadrants
; around the register card (see PINNED in build_office_props_blender.py). The
; ink follows its own paper's centre and grew with it, so each slip reads as a
; printed notice at arm's length instead of a fleck on the baize.
[node name="NoticeTimetableText" type="Label3D" parent="."]
position = Vector3(1.420, 1.700, 2.254)
rotation = Vector3(0, 3.141593, 0.052)
pixel_size = 0.00135
modulate = Color(0.05, 0.04, 0.03, 1)
text = "EAST DIVISION
No. 17  6:05
No. 22  7:15
No. 31  HOLD"
font_size = 11
outline_size = 1
outline_modulate = Color(0.05, 0.04, 0.03, 1)

[node name="NoticeCircularText" type="Label3D" parent="."]
position = Vector3(1.830, 1.710, 2.254)
rotation = Vector3(0, 3.141593, -0.044)
pixel_size = 0.00130
modulate = Color(0.05, 0.04, 0.03, 1)
text = "GENERAL ORDER 12
All operators will
acknowledge receipt
of each order."
font_size = 11
outline_size = 1
outline_modulate = Color(0.05, 0.04, 0.03, 1)

[node name="NoticeMemoText" type="Label3D" parent="."]
position = Vector3(1.400, 1.400, 2.254)
rotation = Vector3(0, 3.141593, -0.070)
pixel_size = 0.00130
modulate = Color(0.04, 0.03, 0.02, 1)
text = "E. —
wind the register
before the next call.
      — J.C."
font_size = 11
outline_size = 1
outline_modulate = Color(0.05, 0.04, 0.03, 1)

[node name="NoticeRuleText" type="Label3D" parent="."]
position = Vector3(1.840, 1.410, 2.254)
rotation = Vector3(0, 3.141593, 0.035)
pixel_size = 0.00130
modulate = Color(0.05, 0.04, 0.03, 1)
