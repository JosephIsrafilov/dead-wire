[sub_resource type="Shader" id="Shader_psx_dither"]
code = "shader_type canvas_item;\nrender_mode unshaded;\n// 15-bit PSX colour: 32 levels per channel, ordered 4x4 Bayer dither on the\n// same pixel grid as the half-resolution 3D buffer, plus a soft lens falloff.\nuniform sampler2D screen_texture : hint_screen_texture, filter_nearest;\nuniform float pixel_size = 2.0;\nuniform float levels = 32.0;\nuniform float vignette = 0.3;\nconst float BAYER[16] = float[](0.0, 8.0, 2.0, 10.0, 12.0, 4.0, 14.0, 6.0, 3.0, 11.0, 1.0, 9.0, 15.0, 7.0, 13.0, 5.0);\nvoid fragment() {\n    vec2 cell = floor(FRAGCOORD.xy / pixel_size);\n    int i = int(mod(cell.x, 4.0)) + int(mod(cell.y, 4.0)) * 4;\n    float b = (BAYER[i] / 16.0 - 0.5) / levels;\n    vec3 c = texture(screen_texture, SCREEN_UV).rgb;\n    c = floor((c + b) * levels + 0.5) / levels;\n    vec2 d = SCREEN_UV - 0.5;\n    c *= 1.0 - vignette * dot(d, d) * 2.0;\n    COLOR = vec4(clamp(c, vec3(0.0), vec3(1.0)), 1.0);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_psx_dither"]
shader = SubResource("Shader_psx_dither")

