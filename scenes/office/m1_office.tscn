[sub_resource type="Shader" id="Shader_psx_dither"]
code = "shader_type canvas_item;\nrender_mode unshaded;\nuniform sampler2D screen_texture : hint_screen_texture, filter_nearest;\nvoid fragment() {\n    vec2 p = FRAGCOORD.xy;\n    float b = (mod(floor(p.x) + floor(p.y) * 2.0, 4.0) - 1.5) * 0.012;\n    vec4 source = texture(screen_texture, SCREEN_UV);\n    vec3 quantized = floor(clamp(source.rgb + b, vec3(0.0), vec3(1.0)) * 10.0) / 10.0;\n    vec3 graded = mix(source.rgb, quantized, 0.34);\n    COLOR = vec4(graded, source.a);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_psx_dither"]
shader = SubResource("Shader_psx_dither")

