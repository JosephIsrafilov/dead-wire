; One static interior probe: the night pane reads as a dark mirror with the
; lamp in it, and brass/glass get something to reflect. Captured once.
; The operator's arm (layer 2) is outside its reflection mask: a grazing view
; along the sleeve would otherwise mirror the room as a grey sheen.
[node name="RoomReflection" type="ReflectionProbe" parent="."]
position = Vector3(0, 1.45, 0)
update_mode = 0
intensity = 0.55
max_distance = 8.0
size = Vector3(5.9, 2.95, 4.7)
interior = true
ambient_mode = 0
reflection_mask = 4294967293

