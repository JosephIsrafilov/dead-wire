[node name="NorthWindow" parent="." instance=ExtResource("8_window")]
position = Vector3(-1.5, 1.55, -2.36)

; ── The view out of the north window ────────────────────────────────────────
;
; The view is built in real depth, not painted (plan 3.2):
;
;   near     fence, ground, the yard's own post and wires   0.4 .. 1.6 m out
;   middle   rails to the shaft, the switch lamp             8 .. 48 m out
;   far      headframe, engine house, stack, spoil bank      45 .. 75 m out
;   very far two ridges                                       150 .. 230 m out
;   sky      gradient, moon, clouds                           300 m out
;
; Nothing here is walkable and nothing is lit from inside: the mine has been
; shut since 1885. The scene fog grades each layer toward the sky, so moving
; the head a hand's width shifts fence against mine against ridge.
;
; The figure still stands at z ≈ -2.85 between the glass and the yard, on the
; clear column at x = -1.5 that every layer below deliberately leaves open.

; --- the sky ----------------------------------------------------------------
; The moon is a disc in this sky where the room's moonlight comes from, and
; MoonWeather draws its clouds over it (night_sky.gdshader). Fog never touches it.
[node name="ExteriorSky" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -1.5, 150.0, -300.0)
mesh = SubResource("SkyQuadMesh")
material_override = ExtResource("6_sky")
cast_shadow = 0

[node name="MineYard" parent="." instance=ExtResource("6_yard")]

; The morning trains (plan 4.6): what the board did, seen and heard at dawn.
[node name="DawnTrain" type="Node3D" parent="."]
script = ExtResource("67_dawn_train")

[node name="DustMotes" parent="." instance=ExtResource("68_dust")]

; The line outside sways a little in the wind (plan 3.9).
[node name="WireSway" type="Node" parent="."]
script = ExtResource("69_wire_sway")

; Snow over the points: an experiment, OFF by default (plan 3.12).
[node name="YardSnow" parent="." instance=ExtResource("70_snow")]

; --- near: the yard -------------------------------------------------------
; The yard's ground runs to the ridges. It starts BEHIND the wall's outer face
; (z = -2.42), not in front of it: the first version reached to z = -2.0 and put
; a dark slab through the north wall into the room.
[node name="ExteriorGround" type="CSGBox3D" parent="."]
position = Vector3(-1.5, -0.02, -152.42)
size = Vector3(700.0, 0.08, 300.0)
material = SubResource("ExteriorSilhouette")

; The fence along the yard's near edge: a rail and posts, the boundary between
; the station's ground and the mine's. Posts every 0.9 m, and one rail missing
; in the middle — the same cheap, partial repair the office itself shows.
[node name="ExteriorFence" type="Node3D" parent="."]

; The fence stands ON the yard's ground, which is at y = 0.02 here, and its
; top rail sits at 1.42 — above the interior sill line, so it is actually in
; the window from the seated view. A fence whose rail is under the sill is a
; fence the player never sees.
[node name="FencePost1" type="CSGBox3D" parent="ExteriorFence"]
position = Vector3(-3.4, 0.72, -3.05)
size = Vector3(0.075, 1.4, 0.075)
material = SubResource("ExteriorTimber")

[node name="FencePost2" type="CSGBox3D" parent="ExteriorFence"]
position = Vector3(-2.5, 0.70, -3.05)
size = Vector3(0.075, 1.36, 0.075)
material = SubResource("ExteriorTimber")

[node name="FencePost3" type="CSGBox3D" parent="ExteriorFence"]
position = Vector3(-0.62, 0.71, -3.05)
size = Vector3(0.075, 1.38, 0.075)
material = SubResource("ExteriorTimber")

[node name="FencePost4" type="CSGBox3D" parent="ExteriorFence"]
position = Vector3(0.3, 0.69, -3.05)
size = Vector3(0.075, 1.34, 0.075)
material = SubResource("ExteriorTimber")

