; Weathered fence timber, barely above the silhouette: at night the yard's
; woodwork reads as a slightly lighter edge than the ground behind it, not as
; a lit object. The mine is shut and nothing out here has a lamp.
; Unshaded, like every other exterior surface. Nothing in the room lights the
; yard — the only light out there is the moon, and that is the window spot —
; so a lit material renders black. The value here IS the look: night timber
; just catching the sky, not a lamp-lit fence.
[sub_resource type="StandardMaterial3D" id="ExteriorTimber"]
shading_mode = 0
albedo_color = Color(0.075, 0.072, 0.07, 1)

; The sky is one far quad behind everything (300 m); its shader works from the
; view direction, so the quad only has to fill the sight cone.
[sub_resource type="QuadMesh" id="SkyQuadMesh"]
size = Vector2(900.0, 460.0)

; The grade (plan 2.12): per-channel curves that lift blue in the shadows and
; trim it in the highlights - cold dark, warm light - with a touch of contrast.
[sub_resource type="Gradient" id="GradeGradient"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0, 0.012, 0.035, 1, 0.5, 0.49, 0.47, 1, 1, 0.97, 0.9, 1)

