[gd_scene load_steps=9 format=3 uid="uid://b1winobs001"]

[ext_resource type="Script" path="res://scripts/events/attention_observation_target.gd" id="1_obs"]

; The figure is a SILHOUETTE, not a lit person.
;
; Shaded materials here were a mistake with a visible cause: the window bounce
; light sits 5 cm from this node, so a rough dark material was being lit from
; the front and the figure came up as a pale grey model of a man — every
; primitive readable. What stands outside a lit window at night is a shape with
; no interior detail, and that is also the honest presentation of an event the
; game refuses to explain: the player sees a presence, not a character model.
;
; Unshaded, and darker than the sky it is cut out of. The values are the two
; tones of a coat and a hat, and nothing else.
[sub_resource type="StandardMaterial3D" id="FigureCloth"]
shading_mode = 0
