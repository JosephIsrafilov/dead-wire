emission_box_extents = Vector3(0.28, 0.25, 0.35)
direction = Vector3(0, 1, 0)
spread = 180.0
initial_velocity_min = 0.004
initial_velocity_max = 0.02
gravity = Vector3(0, -0.002, 0)
turbulence_enabled = true
turbulence_noise_strength = 0.4
turbulence_noise_scale = 3.0
turbulence_influence_min = 0.02
turbulence_influence_max = 0.05
scale_min = 0.6
scale_max = 1.4

