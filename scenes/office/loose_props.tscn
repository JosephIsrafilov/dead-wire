[node name="LooseProps" type="Node3D"]

; An enamel cup, on its side where it rolled. 120 g.
;
; Authored LYING DOWN, not tilted. A cylinder left at a 10-degree lean is not a
; resting pose: Jolt tips it flat on the first physics step and the prop visibly
; jumps the moment the room loads. Rotated 90 degrees about Z so its axis is
; horizontal, with its centre one radius (44 mm) above the floor, it starts at
; equilibrium and stays exactly where it was placed until something touches it.
[node name="TinCup" type="RigidBody3D" parent="."]
transform = Transform3D(0, 1, 0, -1, 0, 0, 0, 0, 1, 1.15, 0.044, 0.85)
script = ExtResource("1_loose")
prop_mass = 0.12
prop_bounce = 0.12
prop_friction = 0.55

[node name="Mesh" type="MeshInstance3D" parent="TinCup"]
mesh = SubResource("CupMesh")
material_override = ExtResource("2_iron")

[node name="Shape" type="CollisionShape3D" parent="TinCup"]
shape = SubResource("CupShape")

; A squat ink bottle, upright and dry. 200 g — still under the mass where the
; shove is capped, so it slides a little rather than resisting.
[node name="InkBottle" type="RigidBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.45, 0.055, 0.55)
script = ExtResource("1_loose")
prop_mass = 0.2
prop_bounce = 0.05
prop_friction = 0.7

[node name="Mesh" type="MeshInstance3D" parent="InkBottle"]
mesh = SubResource("BottleMesh")
material_override = ExtResource("3_dark")

[node name="Shape" type="CollisionShape3D" parent="InkBottle"]
shape = SubResource("BottleShape")
