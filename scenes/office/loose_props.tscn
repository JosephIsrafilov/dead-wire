[gd_scene load_steps=9 format=3]

; Loose depot items on the office floor: things knocked off a table years ago
; and never picked up. They are the room's only rigid bodies.
;
; Placed in open floor between the desk and the routing board, on the lane the
; operator actually walks when he crosses the room to set a route. Deliberately
; NOT on the filing table: that table carries the commit plates, and an extra
; body in front of them would steal the interaction ray.
;
; Masses are 1894 objects, not game units — see scripts/physics/push_impulse.gd
; for why one walk nudges both but only the lighter one skitters.

[ext_resource type="Script" path="res://scripts/physics/loose_prop.gd" id="1_loose"]
[ext_resource type="Material" path="res://materials/style_tests/metal_oxidized.tres" id="2_iron"]
[ext_resource type="Material" path="res://materials/style_tests/routing_slate.tres" id="3_dark"]

[sub_resource type="CylinderMesh" id="CupMesh"]
top_radius = 0.044
bottom_radius = 0.038
height = 0.09
radial_segments = 10
rings = 1

[sub_resource type="CylinderShape3D" id="CupShape"]
radius = 0.044
height = 0.09

[sub_resource type="BoxMesh" id="BottleMesh"]
size = Vector3(0.052, 0.11, 0.052)

[sub_resource type="BoxShape3D" id="BottleShape"]
