[gd_resource type="StandardMaterial3D" format=3]

; The chimney is lit from inside by the wick: an additive warm glaze, so it reads
; as hot glass around a flame instead of a grey tube catching specular.
[resource]
transparency = 1
blend_mode = 1
shading_mode = 0
albedo_color = Color(0.3, 0.19, 0.08, 1)
disable_fog = true
texture_filter = 0
