[ext_resource type="Texture2D" path="res://materials/style_tests/textures/psx/psx_window_mineworks_128.png" id="1_tex"]

; The closed mine across the yard: shed, headframe, spoil bank, fence line.
;
; This is the middle distance. It is painted rather than modelled because the
; player can never walk to it — the plan asks for a convincing view, not an
; exterior level — but it is a separate layer at its own depth, which is what
; makes it move against the ridge when the head moves.
;
; transparency = 2 (ALPHA_SCISSOR) for the same reason as the ridge: hard
; silhouette, exact depth, no sorting against the figure.
[resource]
shading_mode = 0
transparency = 2
alpha_scissor_threshold = 0.5
albedo_color = Color(1, 1, 1, 1)
albedo_texture = ExtResource("1_tex")
texture_filter = 0
