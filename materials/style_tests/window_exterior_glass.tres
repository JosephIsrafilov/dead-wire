[gd_resource type="StandardMaterial3D" format=3]

; Night glass — the pane itself, not the view behind it.
;
; Three things have to be true of old single-pane glass:
;
;  1. It is not a mirror. roughness 0.06 with metallic_specular 0.9 returned a
;     sharp image of the desk lamp, which read on screen as a second moon. The
;     specular is broad and weak now, so the lamp leaves a soft glow at the
;     edge rather than a hard disc in the middle.
;  2. It is not a picture. The material used to sample the SAME night texture
;     as the backdrop, so the view was drawn twice — once on the glass and once
;     behind it. The glass carries no albedo image at all now: what is behind
;     it is the layered exterior, seen through it.
;  3. It is dirty, but dirt is a tint, not a wash. An earlier attempt drove the
;     albedo from a bright radial gradient and lifted the whole view into grey
;     milk. A low-alpha cool tint does the same job and keeps the night dark.
[resource]
shading_mode = 1
transparency = 1
albedo_color = Color(0.34, 0.44, 0.58, 0.16)
roughness = 0.72
metallic_specular = 0.07
texture_filter = 0
