[gd_resource type="StandardMaterial3D" load_steps=3 format=3]

; Night glass — the pane itself, not the view behind it.
;
; Three things have to be true of old single-pane glass:
;
;  1. It is not a mirror by default. roughness 0.06 with metallic_specular 0.9
;     returned a sharp image of the desk lamp, which read on screen as a second
;     moon. WindowGlassMirror makes it a dark mirror only when the lamp is up.
;  2. It is not a picture. The glass carries no image of the view: what is
;     behind it is the yard, seen through it.
;  3. It is a used pane (plan 3.11): a breath of condensation along the bottom
;     where the warm room meets the cold night, thinning to clear glass above.
;     A low, world-mapped vertical fade, so it never hides the yard.

[sub_resource type="Gradient" id="Condensation"]
offsets = PackedFloat32Array(0, 0.35, 1)
colors = PackedColorArray(0.95, 0.97, 1, 1, 0.82, 0.86, 0.92, 0.72, 0.75, 0.8, 0.86, 0.6)

