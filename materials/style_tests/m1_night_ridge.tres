[gd_resource type="StandardMaterial3D" load_steps=2 format=3]

[ext_resource type="Texture2D" path="res://materials/style_tests/textures/psx/psx_window_ridge_128.png" id="1_tex"]

; The far slope beyond the yard: two hill lines, the nearer one darker.
;
; transparency = 2 is ALPHA_SCISSOR, not ALPHA: the silhouette has hard edges
; on purpose (the room's whole style is faceted), and a blended quad would sort
; against the figure standing in front of it. Scissoring is opaque geometry, so
; depth sorting is exact and the figure is never drawn behind the hills.
[resource]
shading_mode = 0
transparency = 2
alpha_scissor_threshold = 0.5
albedo_color = Color(1, 1, 1, 1)
albedo_texture = ExtResource("1_tex")
texture_filter = 0
