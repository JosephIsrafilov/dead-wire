extends Node

## S03 Luckius paper (CC0, opengameart.org/content/various-paper-sound-effects).
@export var paper_stream: AudioStream = preload("res://audio/sfx/foley/paper_sheet.mp3")
## S01 Kenney impactPlate_heavy (CC0, kenney.nl/assets/impact-sounds).
@export var stamp_stream: AudioStream = preload("res://audio/sfx/foley/ink_stamp_cc0.ogg")
@export var lever_stream: AudioStream = preload("res://audio/sfx/foley/route_lever.wav")
@export var latch_stream: AudioStream = preload("res://audio/sfx/foley/door_latch.wav")
## S01 Kenney impactWood_medium (CC0): body weight meets the seat.
@export var chair_stream: AudioStream = preload("res://audio/sfx/foley/chair_settle_cc0.ogg")
@export var pickup_stream: AudioStream = preload("res://audio/sfx/foley/paper_turn.wav")
## Generated by tools/generate_action_foley.py (deterministic, project-owned).
@export var pen_stream: AudioStream = preload("res://audio/sfx/foley/pen_scratch.wav")
@export var key_stream: AudioStream = preload("res://audio/sfx/foley/key_click.wav")
@export var hinge_stream: AudioStream = preload("res://audio/sfx/foley/door_hinge.wav")
@export var feed_stream: AudioStream = preload("res://audio/sfx/foley/sheet_slide.wav")
@export var wick_stream: AudioStream = preload("res://audio/sfx/foley/wick_turn.wav")

## Identical samples machine-gun; a small pitch spread reads as a hand.
@export var winding_stream: AudioStream = preload("res://audio/sfx/foley/register_wind.wav")

const JITTER: float = 0.06

## Local, physical sounds sit on their own bus so the room's fader never has to
## choose between the wind and a hand closing on paper.
const FOLEY_BUS: StringName = &"Foley"
var _bound: bool = false

func _ready() -> void:
	_bind.call_deferred()

func _bind() -> void:
	if _bound or not is_inside_tree() or is_queued_for_deletion():
		return
	var office := get_parent() as M1OfficeController
	if not is_instance_valid(office) or not office.is_inside_tree() or office.is_queued_for_deletion():
		return
	var chair := office.get_node_or_null("Chair") as Node3D
	for component in [office.document_viewer, office.session_controller, office.copy_commit_desk,
			office.routing_board, office.office_door, office.operator_seat, chair]:
		if not _can_bind_to(component):
			return
	var transcript := office.session_controller.transcript_paper
	if not _can_bind_to(transcript):
		return
	var key := office.session_controller.telegraph_key
	var lamp_life := office.get_node_or_null("LampLife") as LampLife
	var lamp := office.get_node_or_null("DeskSetup/OilLamp") as Node3D
	var register := office.get_node_or_null("TelegraphSessionController/TapeRegister") as TapeRegisterController
	for component in [transcript.writer_rig, key, lamp_life, register]:
		if component != null and not _can_bind_to(component):
			return
	if lamp_life != null and not _can_bind_to(lamp):
		return
	# Deferred removal is normal during watch changes. Validate the whole room
	# before touching transforms or connecting even its first physical sound.
	_bound = true
	var paper := AudioStreamPlayer.new()
	paper.name = "Paper"
	paper.stream = paper_stream
	paper.volume_db = -20.0
	paper.bus = FOLEY_BUS
	add_child(paper)
	var paper_down := AudioStreamPlayer.new()
	paper_down.name = "PaperDown"
	paper_down.stream = pickup_stream
	paper_down.volume_db = -24.0
	paper_down.bus = FOLEY_BUS
	add_child(paper_down)
	office.document_viewer.document_opened.connect(func(_id): _play_varied(paper))
	office.document_viewer.document_closed.connect(func(_id): _play_varied(paper_down))
	# The new blank sheet landing on the writing zone has its own short
	# contact sound — the feed, not the viewer.
	var feed := AudioStreamPlayer.new()
	feed.name = "PaperFeed"
	feed.stream = feed_stream
	feed.volume_db = -24.0
	feed.bus = FOLEY_BUS
	add_child(feed)
	transcript.sheet_fed.connect(func(): _play_varied(feed))
	var slide := _source("SheetSlide", feed_stream, transcript.global_position, -26.0)
	transcript.sheet_archived.connect(func(): _play_varied(slide))
	# The nib on paper: far under the sounder, so it never competes with Morse.
	var pen := _source("Pen", pen_stream, transcript.global_position, -30.0)
	if transcript.writer_rig != null:
		transcript.writer_rig.glyph_contact.connect(func(_i): _play_varied(pen))
	if key != null:
		var click := _source("KeyClick", key_stream, key.global_position, -16.0)
		key.key_touched.connect(func(): _play_varied(click))
	var stamp := _source("Stamp", stamp_stream, office.copy_commit_desk.global_position, -13.0)
	# The stamp sound is the physical contact of the press, never the intent
	# a deadline may still reject (B1), and never the acceptance itself.
	office.copy_commit_desk.stamp_contact.connect(func(_id): stamp.play())
	# The hand takes the lever: the throw starts here, the stop lands on the board.
	var lever := _source("LeverThrow", lever_stream, office.routing_board.global_position + Vector3(0, 0.7, 0), -20.0)
	office.routing_board.route_accepted.connect(func(_a): _play_varied(lever))
	if lamp_life != null:
		var wick := _source("Wick", wick_stream, lamp.global_position, -20.0)
		lamp_life.wick_turned_up.connect(wick.play.bind(0.0))
		lamp_life.wick_turned_down.connect(wick.play.bind(0.0))
	if register != null:
		var winder := _source("RegisterWind", winding_stream, register.global_position, -18.0)
		register.register_wound.connect(func(): _play_varied(winder))
	var latch := _source("Latch", latch_stream, Vector3(-1.6, 1.0, 2.25), -15.0)
	office.office_door.door_rattled.connect(latch.play.bind(0.0))
	office.office_door.door_opened.connect(latch.play.bind(0.0))
	var hinge := _source("Hinge", hinge_stream, Vector3(-2.05, 1.2, 2.3), -17.0)
	office.office_door.door_opened.connect(hinge.play.bind(0.0))
	var chair_sound := _source("Chair", chair_stream, chair.global_position, -22.0)
	office.operator_seat.seated.connect(func():
		chair_sound.pitch_scale = 1.0
		chair_sound.play())
	# Standing drags the chair back: lower, heavier than the sit.
	office.operator_seat.stood.connect(func():
		chair_sound.pitch_scale = 0.8
		chair_sound.play())

func _can_bind_to(component: Variant) -> bool:
	# Typed Node arguments reject freed references before validation can run.
	return is_instance_valid(component) and component.is_inside_tree() and not component.is_queued_for_deletion()

func _play_varied(player: Node) -> void:
	player.pitch_scale = 1.0 + randf_range(-JITTER, JITTER)
	player.play()

func _source(label: String, stream: AudioStream, position: Vector3, volume: float) -> AudioStreamPlayer3D:
	var player := AudioStreamPlayer3D.new()
	player.name = label
	player.stream = stream
	player.volume_db = volume
	player.unit_size = 2.0
	player.max_distance = 8.0
	player.bus = FOLEY_BUS
	add_child(player)
	player.global_position = position
	return player
